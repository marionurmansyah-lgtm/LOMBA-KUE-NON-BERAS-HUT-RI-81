      <!-- Tombol aksi di layar utama -->
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 16px;">
        <button type="button" class="cta-btn" onclick="startPresentation()" aria-label="Mulai Panduan">
         ▶ Mulai Panduan
