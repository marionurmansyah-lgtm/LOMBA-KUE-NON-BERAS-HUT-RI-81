     <!-- Topic view -->
     <div id="topic-view" class="hidden" role="region" aria-live="polite" aria-atomic="true" tabindex="-1"></div>

    </div>

    <!-- Controls -->
    <div id="ctrl-wrap" class="hidden" aria-hidden="true">
     <div class="ctrl-row">
      <button id="prev-btn" type="button" class="ctrl-btn" onclick="prevTopic()" aria-label="Sebelumnya">← Prev</button>
      <div id="dots" class="dot-row" role="tablist" aria-label="Navigasi slide"></div>
      <button id="next-btn" type="button" class="ctrl-btn next" onclick="nextTopic()" aria-label="Berikutnya">Next →</button>
