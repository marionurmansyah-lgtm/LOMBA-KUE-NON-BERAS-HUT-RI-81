    <!-- Footer -->
    <div class="foot">
     <p>📍 Diselenggarakan oleh Panitia HUT RI-81 RW.01 Koordinator Lomba Kuliner Ibu Mila</p>
     <p class="big">MINGGU • 16 AGUSTUS 2026 • 15:00 WIB</p>
    </div>
   </div>

  </div>

  <script>
        const topics = [
            {
                label: 'Tema & Tujuan',
                icon: '🎯',
                iconBg: 'var(--pink)',
                titleHTML: 'Tema &<br><span class="accent">Tujuan Lomba</span>',
                render: () => `
                    <p class="topic-desc">Lomba ini punya <strong>3 misi utama</strong> yang keren banget:</p>
                    <ul class="brutal-list">
                        <li><span class="bullet pink">1</span><span>Meningkatkan <strong>kreativitas</strong> mengolah bahan pangan non-beras</span></li>
                        <li><span class="bullet yellow">2</span><span>Mendorong pemanfaatan <strong>bahan pangan lokal</strong> Indonesia</span></li>
                        <li><span class="bullet green">3</span><span>Menumbuhkan semangat <strong>berwirausaha</strong> lewat kuliner</span></li>
                    </ul>
                `
            },
            {
                label: 'Waktu Pelaksanaan',
                icon: '📅',
                iconBg: 'var(--yellow)',
                titleHTML: 'Kapan<br><span class="accent-pink">Lombanya?</span>',
                render: () => `
                    <div class="info-row">
                        <div class="info-tile tile-pink">
                            <div class="emoji">🗓️</div>
                            <div class="lbl">Hari</div>
                            <div class="val">MINGGU</div>
                        </div>
                        <div class="info-tile tile-yellow">
                            <div class="emoji">📆</div>
                            <div class="lbl">Tanggal</div>
                            <div class="val">16 AGUSTUS 2026</div>
                        </div>
                        <div class="info-tile tile-green">
                            <div class="emoji">⏰</div>
                            <div class="lbl">Jam Mulai</div>
                            <div class="val">15:00 WIB</div>
                        </div>
                        <div class="info-tile tile-blue">
                            <div class="emoji">⏱️</div>
                            <div class="lbl">Durasi</div>
                            <div class="val">2 JAM</div>
                        </div>
                    </div>
                    <p class="topic-desc" style="margin-top:18px;">Datang 30 menit sebelumnya buat persiapan ya! 🙌</p>
                `
            },
            {
                label: 'Ketentuan Kue',
                icon: '🧁',
                iconBg: 'var(--green)',
                titleHTML: 'Boleh Pakai<br><span class="accent">Bahan Apa Aja?</span>',
                render: () => `
                    <p class="topic-desc">Bahan utama <strong>selain beras</strong> yang boleh kamu pakai:</p>
                    <div class="chip-row">
                        <span class="chip">🍠 Singkong</span>
                        <span class="chip pink">🍠 Ubi Jalar</span>
                        <span class="chip yellow">🌿 Talas</span>
                        <span class="chip green">🥔 Kentang</span>
                        <span class="chip">🌽 Jagung</span>
                        <span class="chip blue">🍌 Pisang</span>
                        <span class="chip pink">🎃 Labu Kuning</span>
                        <span class="chip yellow">+ Lainnya</span>
                    </div>
                    <ul class="brutal-list" style="margin-top: 18px;">
                        <li><span class="bullet green">✓</span><span>Boleh <strong>kue basah</strong> ATAU <strong>kue kering</strong></span></li>
                        <li><span class="bullet red">✗</span><span>Tidak boleh bahan siap saji sebagai hasil utama</span></li>
                        <li><span class="bullet green">✓</span><span>Wajib <strong>layak konsumsi</strong> &amp; higienis</span></li>
                    </ul>
                `
            },
            {
                label: 'Batas Anggaran',
                icon: '💰',
                iconBg: 'var(--yellow)',
                titleHTML: 'Budget<br><span class="accent-pink">Maksimal?</span>',
                render: () => `
                    <div class="stat-big">
                        <div class="label">Max Biaya Bahan</div>
                        <div class="value">Rp100.000</div>
                        <div class="sub">per peserta / tim</div>
                    </div>
                    <ul class="brutal-list">
                        <li><span class="bullet blue">i</span><span>Wajib serahkan <strong>rincian biaya</strong> ke panitia</span></li>
                        <li><span class="bullet green">✓</span><span>Peralatan masak <strong>TIDAK DIHITUNG</strong></span></li>
                        <li><span class="bullet yellow">!</span><span>Lebih dari 100rb? <strong>Diskualifikasi!</strong></span></li>
                    </ul>
                `
            },
            {
                label: 'Kriteria Penilaian',
                icon: '📊',
                iconBg: 'var(--purple)',
                titleHTML: 'Gimana Cara<br><span class="accent">Juri Nilai?</span>',
                scores: [
                    { label: '👅 Rasa', pct: 35, color: 'pink' },
                    { label: '💡 Kreativitas & Inovasi', pct: 25, color: 'yellow' },
                    { label: '✨ Penampilan', pct: 20, color: 'purple' },
                    { label: '🌿 Bahan Non-Beras', pct: 10, color: 'green' },
                    { label: '💸 Efisiensi Biaya', pct: 10, color: 'blue' }
                ]
            },
            {
                label: 'Diskualifikasi',
                icon: '⚠️',
                iconBg: '#DC2626',
                titleHTML: 'Hal yang<br><span class="accent-pink">DILARANG!</span>',
                render: () => `
                    <div class="warning-box">
                        <p class="topic-desc" style="margin-bottom: 14px; color: #991B1B; font-weight: 600;">Hindari hal-hal ini biar nggak didiskualifikasi:</p>
                        <ul class="brutal-list">
                            <li style="background: white;"><span class="bullet red">✗</span><span>Melebihi batas <strong>Rp100.000</strong></span></li>
                            <li style="background: white;"><span class="bullet red">✗</span><span>Pakai bahan utama <strong>BERAS</strong></span></li>
                            <li style="background: white;"><span class="bullet red">✗</span><span>Bukti <strong>bukan karya sendiri</strong></span></li>
                            <li style="background: white;"><span class="bullet red">✗</span><span>Bahan <strong>tidak layak konsumsi</strong></span></li>
                        </ul>
                    </div>
                `
            },
            {
                label: 'Penentuan Pemenang',
                icon: '🏆',
                iconBg: 'var(--yellow)',
                titleHTML: 'Siapa yang<br><span class="accent">Menang?</span>',
                render: () => `
                    <p class="topic-desc">Pemenang dipilih berdasarkan <strong>total nilai tertinggi</strong> dari dewan juri. Keputusan juri <strong>mutlak</strong> dan tidak dapat diganggu gugat.</p>
                    <div class="trophy-grid">
                        <div class="trophy-item gold">
                            <span class="emoji">🥇</span>
                            <div class="rank">Juara 1</div>
                        </div>
                        <div class="trophy-item silver">
                            <span class="emoji">🥈</span>
                            <div class="rank">Juara 2</div>
                        </div>
                        <div class="trophy-item bronze">
                            <span class="emoji">🥉</span>
                            <div class="rank">Juara 3</div>
                        </div>
                    </div>
                `
            },
            {
                label: 'Penutup',
                icon: '🎉',
                iconBg: 'var(--pink)',
                final: true
            }
        ];

        let currentIdx = -1;
        let autoTimer = null;
        let isAuto = true;

        function startPresentation() {
            document.getElementById('start-screen').classList.add('hidden');
            const view = document.getElementById('topic-view');
            view.classList.remove('hidden');
            const ctrl = document.getElementById('ctrl-wrap');
            ctrl.classList.remove('hidden');
            ctrl.removeAttribute('aria-hidden');
            buildDots();
            showTopic(0);
        }

        function buildDots() {
            const dots = document.getElementById('dots');
            dots.innerHTML = '';
            topics.forEach((_, i) => {
                const d = document.createElement('button');
                d.type = 'button';
                d.className = 'dot';
                d.setAttribute('aria-label', `Slide ${i + 1} dari ${topics.length}: ${topics[i].label}`);
                d.onclick = () => { isAuto = false; clearTimeout(autoTimer); showTopic(i); };
                dots.appendChild(d);
            });
        }

        function renderTopic(idx) {
            const t = topics[idx];
            const view = document.getElementById('topic-view');
            // reset animation then apply class to retrigger
            view.className = 'hidden';
            void view.offsetWidth;
            view.className = 'topic-view';

            if (t.final) {
                view.innerHTML = `
                    <div class="final">
                        <span class="final-emoji" aria-hidden="true">🎉</span>
                        <h2>
                            <span class="w1">Selamat</span>
                            <span class="w2">Berlomba!</span>
                        </h2>
                        <p>Semoga sukses &amp; tunjukkan kreativitasmu!<br>Sampai jumpa di hari lomba 🔥</p>
                        
                        <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 20px;">
                            <button type="button" class="cta-btn green" onclick="daftarViaWA()" aria-label="Daftar via WhatsApp">💬 Daftar via WhatsApp</button>
                            <button type="button" class="cta-btn yellow" onclick="resetPresentation()" aria-label="Mulai ulang presentasi">↻ Mulai Ulang</button>
                        </div>

                        <div class="hash-row" style="justify-content:center;">
                            <span class="hash">#KueNonBeras2026</span>
                            <span class="hash">#JagoanDapur</span>
                        </div>
                    </div>
                `;
                // focus region for screen reader
                view.querySelector('.final')?.setAttribute('tabindex', '-1');
                view.querySelector('.final')?.focus();
                return;
            }

            let body = '';
            if (t.scores) {
                body = `<div style="margin-top: 20px;">`;
                t.scores.forEach(s => {
                    body += `
                        <div class="score-row">
                            <div class="score-top">
                                <span class="score-name">${s.label}</span>
                                <span class="score-pct">${s.pct}%</span>
                            </div>
                            <div class="score-track">
                                <div class="score-fill ${s.color}" data-target="${s.pct}" aria-hidden="true"></div>
                            </div>
                        </div>
                    `;
                });
                body += `</div>`;
            } else if (t.render) {
                body = t.render();
            }

            view.innerHTML = `
                <div class="topic-head">
                    <span class="topic-num">${String(idx + 1).padStart(2, '0')} / ${String(topics.length).padStart(2, '0')}</span>
                    <span class="topic-label">${t.label}</span>
                </div>
                <div class="icon-block" style="background: ${t.iconBg};" aria-hidden="true">${t.icon}</div>
                <h2 class="topic-title" tabindex="-1">${t.titleHTML}</h2>
                ${body}
            `;

            // focus the topic title for screen reader & keyboard users
            const titleEl = view.querySelector('.topic-title');
            if (titleEl) {
                titleEl.setAttribute('tabindex', '-1');
                titleEl.focus({ preventScroll: false });
            }

            if (t.scores) {
                // animate fills unless user prefers reduced motion
                if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    setTimeout(() => {
                        document.querySelectorAll('.score-fill').forEach(bar => {
                            bar.style.width = bar.dataset.target + '%';
                        });
                    }, 250);
                } else {
                    // if reduced motion, set width immediately to avoid animation
                    document.querySelectorAll('.score-fill').forEach(bar => {
                        bar.style.width = bar.dataset.target + '%';
                    });
                }
            }
        }

        function showTopic(idx) {
            if (idx < 0 || idx >= topics.length) return;
            currentIdx = idx;
            renderTopic(idx);

            document.querySelectorAll('.dot').forEach((d, i) => {
                d.classList.toggle('active', i === idx);
                d.setAttribute('aria-pressed', String(i === idx));
            });

            document.getElementById('prev-btn').disabled = idx === 0;

            const t = topics[idx];
            document.getElementById('page-ind').innerHTML =
                `<strong>${String(idx + 1).padStart(2, '0')}</strong> dari <strong>${topics.length}</strong> • ${t.label}`;

            const nextBtn = document.getElementById('next-btn');
            if (idx === topics.length - 1) {
                nextBtn.textContent = '✓ Selesai';
                nextBtn.onclick = () => {
                    // Respect reduced motion and avoid repeated confetti
                    createConfetti();
                    nextBtn.disabled = true;
                    nextBtn.setAttribute('aria-disabled', 'true');
                };
                // small delay then confetti
                setTimeout(() => createConfetti(), 300);
            } else {
                nextBtn.innerHTML = 'Next →';
                nextBtn.onclick = () => nextTopic();
                nextBtn.disabled = false;
                nextBtn.removeAttribute('aria-disabled');
            }

            // auto-advance logic
            clearTimeout(autoTimer);
            if (isAuto && idx < topics.length - 1) {
                const dur = t.scores ? 6000 : 5000;
                autoTimer = setTimeout(() => nextTopic(), dur);
            }
        }

        function nextTopic() {
            isAuto = false;
            clearTimeout(autoTimer);
            if (currentIdx < topics.length - 1) showTopic(currentIdx + 1);
        }

        function prevTopic() {
            isAuto = false;
            clearTimeout(autoTimer);
            if (currentIdx > 0) showTopic(currentIdx - 1);
        }

        function resetPresentation() {
            document.getElementById('start-screen').classList.remove('hidden');
            document.getElementById('topic-view').classList.add('hidden');
            document.getElementById('ctrl-wrap').classList.add('hidden');
            document.getElementById('ctrl-wrap').setAttribute('aria-hidden', 'true');
            currentIdx = -1;
            isAuto = true;
            clearTimeout(autoTimer);
            // return focus to first CTA (improves keyboard flow)
            const startBtn = document.querySelector('.start-hero .cta-btn');
            if (startBtn) startBtn.focus();
        }

        function createConfetti() {
            // Respect user's reduced-motion preference
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const emojis = ['🎉', '🎊', '✨', '🏆', '⭐', '🍰', '🧁', '🎂'];
            for (let i = 0; i < 35; i++) {
                setTimeout(() => {
                    const c = document.createElement('div');
                    c.className = 'confetti';
                    c.style.left = Math.random() * 100 + 'vw';
                    c.style.top = '-40px';
                    c.style.animationDuration = (Math.random() * 2 + 2) + 's';
                    c.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                    document.body.appendChild(c);
                    setTimeout(() => c.remove(), 5000);
                }, i * 50);
            }
        }

        // FUNGSI PENDAFTARAN WHATSAPP (aman dan meng-encode pesan)
        function daftarViaWA() {
            const nomorWA = "6285782674710";
            const pesanPlain = `Halo Ibu Mila (Panitia Lomba Kuliner),

Saya ingin mendaftar *LOMBA KUE NON-BERAS HUT RI-81*:

- *Nama Peserta / Tim:*
- *RT:*
- *Rencana Olahan Kue:*

Mohon konfirmasi pendaftarannya. Terima kasih!`;
            const pesan = encodeURIComponent(pesanPlain);
            const url = `https://wa.me/${nomorWA}?text=${pesan}`;

            // create safe anchor to open in new tab with rel=noopener noreferrer
            const a = document.createElement('a');
            a.href = url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            a.style.display = 'none';
            document.body.appendChild(a);
            a.click();
            a.remove();
        }

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            // If start screen visible, allow Enter/Space to start
            const startVisible = !document.getElementById('start-screen').classList.contains('hidden');
            if (startVisible && (e.key === 'Enter' || e.key === ' ')) {
                e.preventDefault();
                startPresentation();
                return;
            }

            if (currentIdx === -1) return;
            if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); nextTopic(); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); prevTopic(); }
        });

        // Touch gestures
        let touchX = 0;
        document.addEventListener('touchstart', (e) => { touchX = e.changedTouches[0].screenX; });
        document.addEventListener('touchend', (e) => {
            if (currentIdx === -1) return;
            const d = touchX - e.changedTouches[0].screenX;
            if (Math.abs(d) > 50) {
                if (d > 0) nextTopic(); else prevTopic();
            }
        });
    </script>

